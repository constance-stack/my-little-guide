# Local dev — safe to commit structure but not real secrets. This file itself is gitignored.
DATABASE_URL="postgresql://constance@localhost:5432/my_little_guide_dev"

# Auth.js
AUTH_SECRET="dev-only-insecure-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Email (dev: Mailpit SMTP catcher)
EMAIL_SERVER_HOST="localhost"
EMAIL_SERVER_PORT="1025"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="My Little Guide <hello@mylittleguide.test>"

# Stripe test mode (fill in with your own free test-mode keys — see README)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Map (free MapTiler API key — see README)
NEXT_PUBLIC_MAPTILER_KEY=""

# Trip organizer routing (free OpenRouteService key — see README)
OPENROUTESERVICE_KEY=""

# Google Places API (New) — optional live photo fallback for places with no
# verified Wikimedia Commons photo (mostly restaurants/bars). Leaving this
# empty disables the fallback entirely; no other change needed. Requires a
# Google Cloud project with billing enabled and "Places API (New)" turned
# on — see src/lib/google-places.ts for what it's used for and the caching
# rules it follows.
GOOGLE_PLACES_API_KEY=""

# Local private file storage root
STORAGE_ROOT="./storage"
